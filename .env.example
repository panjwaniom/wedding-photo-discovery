# Immich Configuration
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=replace_with_your_api_key

# Create API key at: http://localhost:2283/user-settings → API Keys

# Database (must match your Immich installation)
DB_PASSWORD=postgres

# Face Matching (lower = finds more angled/side photos, confirm screen guards mismatches)
FACE_MATCH_THRESHOLD=0.55
# Face detection sensitivity (lower = detects more angled/partial faces)
MIN_DETECTION_SCORE=0.3

# Couple (also see all unassigned photos in their results) — Immich person IDs
COUPLE_PERSON_IDS=

# Upload Settings
MAX_UPLOAD_MB=10
SEARCH_SESSION_MINUTES=30

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Immich Library Location
UPLOAD_LOCATION=./library
